# Radar image/config
RADAR_IMAGE=odhomane/radar:latest
RADAR_CONTAINER_NAME=radar
RADAR_PORT=8585
KUBECONFIG_PATH=/Users/you/.kube/config
GCLOUD_CONFIG_PATH=/Users/you/.config/gcloud

# Authentik core
AUTHENTIK_VERSION=2025.8
AUTHENTIK_PORT=9000
AUTHENTIK_SECRET_KEY=replace-with-long-random-string
AUTHENTIK_POSTGRES_DB=authentik
AUTHENTIK_POSTGRES_USER=authentik
AUTHENTIK_POSTGRES_PASSWORD=replace-with-strong-db-password

# Optional one-time bootstrap
AUTHENTIK_BOOTSTRAP_PASSWORD=
AUTHENTIK_BOOTSTRAP_TOKEN=

# Outpost (set after creating Proxy Provider/Outpost in Authentik UI)
AUTHENTIK_OUTPOST_TOKEN=replace-after-outpost-creation
RADAR_AUTH_PORT=4180

# Optional container names
AUTHENTIK_DB_CONTAINER_NAME=authentik-db
AUTHENTIK_REDIS_CONTAINER_NAME=authentik-redis
AUTHENTIK_SERVER_CONTAINER_NAME=authentik-server
AUTHENTIK_WORKER_CONTAINER_NAME=authentik-worker
AUTHENTIK_OUTPOST_CONTAINER_NAME=authentik-outpost
